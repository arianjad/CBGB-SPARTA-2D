# Fluorescence buffer-gas cooling cell, 3D, 23K neon DSMC.
# Structure follows cases/takahashi-3d/in.he_takahashi_3d_scoping.
#
# Geometry: cell_fluor3d.surf from gen_fluor3d.py
# (fluorescence_cooling_cell_installed.step). Screw holes plugged, 3 ports:
#   type 1 = 23K wall
#   type 2 = buffer gas inlet, sealed cap with emit/surf (as if fed from a
#            line plugged into the 1.588mm port; check against the real feed)
#   type 3 = molecule inlet channel (2.54mm, open). SPARTA doesn't track the
#            molecules/ions (Julia tracer does, on the frozen Ne field); tagged
#            only so its Ne flux can be measured.
#   type 4 = molecule outlet channel (3.175mm, open), same.
#
# Species: ne.species/ne.vss, VHS from Bird 1994 Table A1 (d=2.79e-10m,
# omega=0.66, Tref=273.15K), not the hard-sphere convention of he.species.
#
# Ions: BaF+ at 500 eV is not in this deck; SPARTA only does the neutral Ne.
# The tracer's mean-speed elastic-collision model assumes near-thermal
# species, so a 500 eV ion slowing in 23K Ne needs a separate
# stopping-power/energy-loss treatment before trusting stopping distances.
#
# TODO before a real run:
#   - create_box / region gas bounds are a placeholder, not from the real
#     downstream chamber or pumping.
#   - create_grid is one flat level; the He cases use nested 2:1 bands sized
#     to the local mean free path (gen_b5.py nonface(), in.he_b5_mflow
#     levelN regions). The ports (1.588/2.54/3.175mm) probably need the same,
#     with cell sizes re-derived for 23K Ne.
#   - MDOT/FILLN/FNUM/DT/STEPS: pass with -var, as in tools/run_helium.sh.
#   - inlet cap placement (30.48,25.400, 0.5mm depth; gen_fluor3d.py
#     GAS_INLET_CAP_DEPTH_MM) is a modeling assumption, not a CAD feature.

variable    SEED index 8675309
variable    WEIGHT index radius
seed        ${SEED}
units       si
dimension   3
boundary    o o o
global      gridcut 0.0
global      surfmax 2000
create_box  0.005 0.200 -0.020 0.070 -0.030 0.080
create_grid 60 27 33
balance_grid rcb cell
global      mem/limit 1900
species     ne.species Ne
mixture     negas Ne nrho 1.0e22 temp 23.0
mixture     fillgas Ne nrho ${FILLN} temp 23.0
global      fnum ${FNUM}
collide     vss negas ne.vss
read_surf   cell_fluor3d.surf type group cellwalls clip
surf_collide walls diffuse 23.0 1.0
surf_modify cellwalls collide walls
group       gasinlet surf type 2
group       moleculein surf type 3
group       moleculeout surf type 4
region      gas block 0.031 0.082 0.001 0.043 -0.005 0.039
create_particles fillgas n 0 region gas
balance_grid rcb part
fix         bal balance 5000 1.1 rcb time
global      particle/reorder 100
fix         src emit/surf negas gasinlet normal yes mflow ${MDOT} 23.0
compute     cmi surf moleculein negas nflux norm flow
fix         ami ave/surf moleculein 10 100 1000 c_cmi[1]
dump        dmi surf moleculein 1000 moleculein.out id f_ami
compute     cmo surf moleculeout negas nflux norm flow
fix         amo ave/surf moleculeout 10 100 1000 c_cmo[1]
dump        dmo surf moleculeout 1000 moleculeout.out id f_amo
compute     cg grid all negas nrho u v w
compute     tg thermal/grid all negas temp
fix         ag ave/grid all 10 2000 20000 c_cg[*] c_tg[*]
dump        gd grid all 20000 field.grid id xc yc zc xlo ylo zlo xhi yhi zhi f_ag[*]
stats       5000
stats_style step cpu np nattempt ncoll f_src[1] f_src[2]
stats_modify flush yes
timestep    ${DT}
run         ${STEPS}
