# Sealed-window production run: same as in.ne_fluor3d_run but on
# cell_fluor3d_sealed.surf (seal_top_slot.py -- the open optical-window slot
# had been leaking ~70% of the gas) with the chamber refined 8x8x8.
# Sealed, the chamber fills to ~5e21 m^-3 (the handoff's aperture-law
# FILLN), where the 23K Ne mean free path is ~0.4mm; the flat 3.25-3.33mm
# grid would be ~9 mean free paths per cell, so region CAV (the chamber and
# both port channels) is refined to ~0.41mm cells. Exterior stays coarse
# (lambda there is >10mm). Averaging window is 10 x DUMPFREQ/10 = DUMPFREQ steps,
# so pass CHECKPOINT_STEPS = DUMPFREQ (restarts must land on window edges).
#
# Checkpointed production run of the fluor-cell-3d case, mirroring
# cases/takahashi-3d/in.he_takahashi_3d_run's chunked restart pattern.
# Same geometry/species/setup as in.ne_fluor3d_scoping.
#
# Checkpointed: writes a full SPARTA restart file every CHECKPOINT_STEPS (in
# addition to the running field.grid dump), so a job killed early (walltime
# limit, node failure) does not lose all progress -- resume with
# in.ne_fluor3d_resume from the latest restart.<step> file.
# Pass MDOT (kg/s), FILLN (m^-3), FNUM, DT (s), DUMPFREQ,
# CHECKPOINT_STEPS, and NCHUNKS with -var.

variable    SEED index 8675309
variable    REFINE index 8      # chamber (region CAV) refinement per axis: 8 -> 0.41mm cells, 16 -> 0.20mm
variable    WEIGHT index radius
seed        ${SEED}
units       si
dimension   3
boundary    o o o
global      gridcut 0.0
global      surfmax 2000
create_box  0.005 0.200 -0.020 0.070 -0.030 0.080
region      CAV block 0.0295 0.0835 0.002 0.042 -0.001 0.0365
create_grid 60 27 33 levels 2 region 2 CAV ${REFINE} ${REFINE} ${REFINE} inside any
balance_grid rcb cell
global      mem/limit 1900
species     ne.species Ne
mixture     negas Ne nrho 1.0e22 temp 23.0
mixture     fillgas Ne nrho ${FILLN} temp 23.0
global      fnum ${FNUM}
collide     vss negas ne.vss
read_surf   cell_fluor3d_sealed.surf type group cellwalls clip
surf_collide walls diffuse 23.0 1.0
surf_modify cellwalls collide walls
group       gasinlet surf type 2
group       moleculein surf type 3
group       moleculeout surf type 4
region      gas block 0.031 0.082 0.001 0.043 -0.005 0.039
create_particles fillgas n 0 region gas
balance_grid rcb part
fix         bal balance 5000 1.1 rcb time
global      particle/reorder 100
fix         src emit/surf negas gasinlet normal yes mflow ${MDOT} 23.0
compute     cmi surf moleculein negas nflux norm flow
fix         ami ave/surf moleculein 10 100 1000 c_cmi[1]
dump        dmi surf moleculein 1000 moleculein.out id f_ami
compute     cmo surf moleculeout negas nflux norm flow
fix         amo ave/surf moleculeout 10 100 1000 c_cmo[1]
dump        dmo surf moleculeout 1000 moleculeout.out id f_amo
compute     cg grid all negas nrho u v w
compute     tg thermal/grid all negas temp
variable    NREP equal ${DUMPFREQ}/10
fix         ag ave/grid all 10 ${NREP} ${DUMPFREQ} c_cg[*] c_tg[*]
dump        gd grid all ${DUMPFREQ} field.grid id xc yc zc xlo ylo zlo xhi yhi zhi f_ag[*]
stats       5000
stats_style step cpu np nattempt ncoll f_src[1] f_src[2]
stats_modify flush yes
timestep    ${DT}

variable    loop_i loop ${NCHUNKS}
label       loop
run         ${CHECKPOINT_STEPS}
write_restart restart.%.*
next        loop_i
jump        SELF loop
